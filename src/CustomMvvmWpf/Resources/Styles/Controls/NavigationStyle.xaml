<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Wpf.Ui.Controls;assembly=Wpf.Ui">

    <Style TargetType="{x:Type controls:NavigationViewContentPresenter}"
           BasedOn="{StaticResource DefaultNavigationViewContentPresenterStyle}">
        <Setter Property="FocusVisualStyle"
                Value="{x:Null}" />
        <Setter Property="IsTabStop"
                Value="False" />
        <Setter Property="SnapsToDevicePixels"
                Value="True" />
        <Setter Property="OverridesDefaultStyle"
                Value="True" />
        <Setter Property="JournalOwnership"
                Value="OwnsJournal" />

        <Style.Triggers>
            <Trigger Property="IsDynamicScrollViewerEnabled"
                     Value="True">
                <Setter Property="Template"
                        Value="{StaticResource DefaultNavigationViewContentPresenterControlTemplate}" />
            </Trigger>
            <Trigger Property="IsDynamicScrollViewerEnabled"
                     Value="False">
                <Setter Property="Template"
                        Value="{StaticResource DefaultNavigationViewContentPresenterControlTemplate}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
