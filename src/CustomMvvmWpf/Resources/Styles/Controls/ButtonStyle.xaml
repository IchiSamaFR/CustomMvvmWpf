<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Resources/Styles/Tokens/FontSize.xaml" />
        <ResourceDictionary Source="/Resources/Styles/Tokens/Color.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Déclaration des styles de boutons -->
    <Style x:Key="PrimaryButtonStyle"
           TargetType="ui:Button"
           BasedOn="{StaticResource DefaultUiButtonStyle}">
        <Setter Property="Appearance"
                Value="Primary" />
        <Setter Property="MinHeight"
                Value="36" />
    </Style>

    <Style x:Key="TextButtonBorderStyle"
           TargetType="ui:Button"
           BasedOn="{StaticResource PrimaryButtonStyle}">
        <Setter Property="Appearance"
                Value="Transparent" />
    </Style>
    
    <Style x:Key="TextButtonStyle"
           TargetType="ui:Button"
           BasedOn="{StaticResource TextButtonBorderStyle}">
        <Setter Property="BorderThickness"
                Value="0" />
    </Style>

    <Style x:Key="SecondaryButtonStyle"
           TargetType="ui:Button"
           BasedOn="{StaticResource PrimaryButtonStyle}">
        <Setter Property="Appearance"
                Value="Secondary" />
    </Style>

    <Style x:Key="DangerButtonStyle"
           TargetType="ui:Button"
           BasedOn="{StaticResource PrimaryButtonStyle}">
        <Setter Property="Appearance"
                Value="Danger" />
    </Style>

    <Style x:Key="SuccessButtonStyle"
           TargetType="ui:Button"
           BasedOn="{StaticResource PrimaryButtonStyle}">
        <Setter Property="Appearance"
                Value="Success" />
    </Style>

    <Style x:Key="CautionButtonStyle"
           TargetType="ui:Button"
           BasedOn="{StaticResource PrimaryButtonStyle}">
        <Setter Property="Appearance"
                Value="Caution" />
    </Style>

    <!-- Default Button Style -->
    <Style TargetType="ui:Button"
           BasedOn="{StaticResource PrimaryButtonStyle}" />

</ResourceDictionary>