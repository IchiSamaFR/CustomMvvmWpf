<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Resources/Styles/Tokens/FontSize.xaml" />
        <ResourceDictionary Source="/Resources/Styles/Tokens/Color.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Style de base : commun à tous les labels -->
    <Style x:Key="LabelBaseStyle"
           TargetType="Label">
        <Setter Property="FontFamily"
                Value="Segoe UI" />
        <Setter Property="Foreground"
                Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="VerticalContentAlignment"
                Value="Center" />
        <Setter Property="Padding"
                Value="0" />
    </Style>

    <!-- Titre principal -->
    <Style x:Key="LabelTitleStyle"
           TargetType="Label"
           BasedOn="{StaticResource LabelBaseStyle}">
        <Setter Property="FontSize"
                Value="{StaticResource FontSizeXLarge}" />
        <Setter Property="FontWeight"
                Value="SemiBold" />
    </Style>

    <!-- Titre de section -->
    <Style x:Key="LabelHeadingStyle"
           TargetType="Label"
           BasedOn="{StaticResource LabelBaseStyle}">
        <Setter Property="FontSize"
                Value="{StaticResource FontSizeLarge}" />
        <Setter Property="FontWeight"
                Value="SemiBold" />
    </Style>

    <!-- Sous-titre / label important -->
    <Style x:Key="LabelSubtitleStyle"
           TargetType="Label"
           BasedOn="{StaticResource LabelBaseStyle}">
        <Setter Property="FontSize"
                Value="{StaticResource FontSizeMedium}" />
        <Setter Property="FontWeight"
                Value="Medium" />
    </Style>

    <!-- Texte courant (par défaut) -->
    <Style x:Key="LabelDefaultStyle"
           TargetType="Label"
           BasedOn="{StaticResource LabelBaseStyle}">
        <Setter Property="FontSize"
                Value="{StaticResource FontSizeNormal}" />
        <Setter Property="FontWeight"
                Value="Normal" />
    </Style>

    <!-- Texte secondaire / atténué -->
    <Style x:Key="LabelSecondaryStyle"
           TargetType="Label"
           BasedOn="{StaticResource LabelBaseStyle}">
        <Setter Property="FontSize"
                Value="{StaticResource FontSizeNormal}" />
        <Setter Property="Foreground"
                Value="{StaticResource BrushTextSecondary}" />
    </Style>
    
    <!-- Texte accentué -->
    <Style x:Key="LabelAccentStyle"
           TargetType="Label"
           BasedOn="{StaticResource LabelBaseStyle}">
        <Setter Property="FontSize"
                Value="{StaticResource FontSizeNormal}" />
        <Setter Property="Foreground"
                Value="{StaticResource BrushAccentPrimary}" />
    </Style>

    <!-- Légende / hint -->
    <Style x:Key="LabelCaptionStyle"
           TargetType="Label"
           BasedOn="{StaticResource LabelBaseStyle}">
        <Setter Property="FontSize"
                Value="{StaticResource FontSizeSmall}" />
        <Setter Property="Foreground"
                Value="{StaticResource BrushTextTertiary}" />
    </Style>

    <!-- Label désactivé -->
    <Style x:Key="LabelDisabledStyle"
           TargetType="Label"
           BasedOn="{StaticResource LabelBaseStyle}">
        <Setter Property="FontSize"
                Value="{StaticResource FontSizeNormal}" />
        <Setter Property="Foreground"
                Value="{StaticResource BrushTextDisabled}" />
    </Style>

    <!-- Style par défaut implicite (sans x:Key), appliqué à tout Label -->
    <Style TargetType="Label"
           BasedOn="{StaticResource LabelDefaultStyle}" />

</ResourceDictionary>