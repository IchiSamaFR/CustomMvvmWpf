<#@ template debug="false" hostspecific="true" language="C#" #>
<#@ output extension=".cs" #>
<#@ assembly name="System.Core" #>
<#@ import namespace="System" #>
<#@ import namespace="System.IO" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Collections.Generic" #>
<#
	// Dossier du projet = dossier contenant ce .tt
	var projectDir = Path.Combine(Path.GetDirectoryName(Host.TemplateFile), "..");

	// Namespace racine = <RootNamespace> du .csproj, sinon nom du .csproj (comportement MSBuild)
	var csproj = Directory.EnumerateFiles(projectDir, "*.csproj").First();
	var rootNs = Path.GetFileNameWithoutExtension(csproj);
	var rootNsTag = System.Text.RegularExpressions.Regex.Match(File.ReadAllText(csproj), @"<RootNamespace>\s*([^<\s]+)\s*</RootNamespace>");
	if (rootNsTag.Success)
	{
		rootNs = rootNsTag.Groups[1].Value;
	}

	// URI XAML dérivée du namespace pour ne dépendre d'aucun nom en dur
	var xmlnsBaseUri = "http://" + rootNs.ToLowerInvariant() + ".com/dotnet/wpf/";
	
	var globalMap = new List<string>
	{
		rootNs + ".Controls",
		rootNs + ".Behaviors",
		rootNs + ".ViewModels",
		rootNs + ".Views"
	};

	// Liste de règles: Ns = préfixe de namespace à matcher (StartsWith),
	// Suffix = suffixe d'URI XAML
	var nsMap = new List<(string Ns, string Suffix)>
	{
		( rootNs + ".Converters", "converters" ),
	};

	// Récupère tous les namespaces déclarés dans les fichiers .cs du projet
	var namespaces = new SortedSet<string>(StringComparer.Ordinal);

	foreach (var file in Directory.EnumerateFiles(projectDir, "*.cs", SearchOption.AllDirectories))
	{
		var rel = file.Substring(projectDir.Length).Replace('\\', '/');

		// On ignore les sorties de build et les fichiers générés.
		if (rel.Contains("/obj/") || rel.Contains("/bin/") || rel.Contains("/Generated/"))
			continue;
		if (file.EndsWith(".g.cs", StringComparison.Ordinal) ||
			file.EndsWith(".g.i.cs", StringComparison.Ordinal) ||
			file.EndsWith(".g.shared.cs", StringComparison.Ordinal))
			continue;

		// Lecture ligne à ligne pour détecter les déclarations 'namespace'
		foreach (var rawLine in File.ReadLines(file))
		{
			var line = rawLine.Trim();
			if (line.StartsWith("namespace ", StringComparison.Ordinal))
			{
				var ns = line.Substring("namespace ".Length).Trim();

				// Retirer un '{' éventuel ou tout autre séparateur
				var sepIdx = ns.IndexOfAny(new[] { ' ', '{', ';' });
				if (sepIdx >= 0)
				{
					ns = ns.Substring(0, sepIdx).Trim();
				}

				if (!string.IsNullOrEmpty(ns))
				{
					namespaces.Add(ns);
				}
			}
		}
	}

	// Construit la liste triée et dédupliquée des attributs.
	var definitionLines = new SortedSet<string>(StringComparer.Ordinal); // XmlnsDefinition -> pour apparaitre en premier
	
	foreach (var ns in namespaces)
	{
		foreach (var rule in globalMap)
		{
			if (ns.StartsWith(rule, StringComparison.Ordinal))
			{
				var uri = string.Format("http://schemas.microsoft.com/winfx/2006/xaml/presentation", rule);
				// Ajoute une XmlnsDefinition pour le namespace trouvé
				definitionLines.Add(string.Format(
					"[assembly: XmlnsDefinition(\"{0}\", \"{1}\")]", uri, ns));
				break; // premier match suffit
			}
		}
		foreach (var rule in nsMap)
		{
			if (ns.StartsWith(rule.Ns, StringComparison.Ordinal))
			{
				var uri = xmlnsBaseUri + rule.Suffix;
				// Ajoute une XmlnsDefinition pour le namespace trouvé
				definitionLines.Add(string.Format(
					"[assembly: XmlnsDefinition(\"{0}\", \"{1}\")]", uri, ns));
				break; // premier match suffit
			}
		}
	}

	// Concatène d'abord les XmlnsDefinition, puis les XmlnsPrefix
	var outputAttributes = string.Empty;
	if (definitionLines.Count > 0)
	{
		outputAttributes = string.Join(Environment.NewLine, definitionLines);
	}
#>
//------------------------------------------------------------------------------
// <auto-generated>
//     Ce fichier est généré par AssemblyInfo.tt — NE PAS L'ÉDITER À LA MAIN.
//     Pour régénérer : clic droit sur AssemblyInfo.tt > "Exécuter l'outil
//     personnalisé" (Run Custom Tool), ou enregistrez simplement le .tt.
// </auto-generated>
//------------------------------------------------------------------------------
using System.Windows.Markup;
using System.Windows;

[assembly: ThemeInfo(
    ResourceDictionaryLocation.None,            //where theme specific resource dictionaries are located
                                                //(used if a resource is not found in the page,
                                                // or application resource dictionaries)
    ResourceDictionaryLocation.SourceAssembly   //where the generic resource dictionary is located
                                                //(used if a resource is not found in the page,
                                                // app, or any theme specific resource dictionaries)
)]

<#= outputAttributes.TrimStart() #>
