<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!-- Déclaration des styles de ComboBox -->
    <Style x:Key="ComboBoxStyle"
           TargetType="ComboBox"
           BasedOn="{StaticResource DefaultComboBoxStyle}">
        <Setter Property="MinHeight"
                Value="36" />
    </Style>

    <Style x:Key="TextComboBoxBorderStyle"
           TargetType="ComboBox"
           BasedOn="{StaticResource ComboBoxStyle}">
        <Setter Property="Background"
                Value="Transparent" />
    </Style>

    <Style x:Key="TextComboBoxStyle"
           TargetType="ComboBox"
           BasedOn="{StaticResource TextComboBoxBorderStyle}">
        <Setter Property="BorderThickness"
                Value="0" />
    </Style>

    <!-- Default ComboBox Style -->
    <Style TargetType="ComboBox"
           BasedOn="{StaticResource TextComboBoxStyle}" />

</ResourceDictionary>