<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Wpf.Ui;component/Controls/ListBox/ListBoxItem.xaml" />
    </ResourceDictionary.MergedDictionaries>
    
    <Style x:Key="ListBoxItemBaseStyle"
           TargetType="ListBoxItem"
           BasedOn="{StaticResource DefaultListBoxItemStyle}">
        <Setter Property="Padding"
                Value="4,2" />
        <Setter Property="Margin"
                Value="0" />
    </Style>

    <Style TargetType="ListBoxItem"
           BasedOn="{StaticResource ListBoxItemBaseStyle}" />

</ResourceDictionary>